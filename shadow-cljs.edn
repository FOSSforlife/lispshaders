;; shadow-cljs build config — `npm run dev` serves the app at http://localhost:8021
{:source-paths ["src" "test"]

 :dependencies [[reagent "1.2.0"]]

 :dev-http {8021 "public"}

 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "/js"
        :modules {:main {:init-fn lispshaders.core/init!}}
        :devtools {:after-load lispshaders.core/after-load!}}

  ;; Node-based unit tests for the Clojure->GLSL compiler
  :test {:target :node-test
         :output-to "out/node-tests.js"
         :ns-regexp "-test$"}

  ;; Dev utility: dump every example's compiled GLSL for inspection
  :dump {:target :node-script
         :main lispshaders.dump/main!
         :output-to "out/dump.js"}}}
